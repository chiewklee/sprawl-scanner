<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:vm="http://www.mulesoft.org/schema/mule/vm"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/vm http://www.mulesoft.org/schema/mule/vm/current/mule-vm.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <!-- Non-secret defaults. Secrets (gemini.apiKey, anypoint.clientId, anypoint.clientSecret)
         come from CloudHub 2.0 Secured Application Properties, never from files. -->
    <configuration-properties file="application.properties" />

    <http:listener-config name="sprawl-scanner-api-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="${http.port}" />
    </http:listener-config>

    <!-- Persistent stores: Object Store v2 on CloudHub 2.0 (persistentObjectStore=true).
         scans: scan records, history, latest pointer, results. caches: embeddings + verdicts. -->
    <os:object-store name="scanStore" persistent="true" />
    <os:object-store name="cacheStore" persistent="true" />

    <vm:config name="scanVm">
        <vm:queues>
            <vm:queue queueName="scanQueue" queueType="PERSISTENT" />
        </vm:queues>
    </vm:config>
</mule>
