# Names only. Copy to .env (gitignored) or export in your shell; never commit values.

# Secured Application Properties for the Mule app (same names, lower-case dotted, on CloudHub):
GEMINI_API_KEY=                     # -> gemini.apiKey
SCANNER_ANYPOINT_CLIENT_ID=         # -> anypoint.clientId      (Connected App: Exchange Viewer + API Manager read)
SCANNER_ANYPOINT_CLIENT_SECRET=     # -> anypoint.clientSecret
SALESFORCE_CLIENT_ID=               # -> mcpAuth.salesforce.clientId     (optional: Salesforce MCP tool lists)
SALESFORCE_CLIENT_SECRET=           # -> mcpAuth.salesforce.clientSecret

# Only for scripts/set_secure_properties.py (a Connected App allowed to manage Runtime Manager apps):
DEPLOYER_CLIENT_ID=
DEPLOYER_CLIENT_SECRET=
